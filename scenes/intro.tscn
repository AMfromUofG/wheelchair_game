[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/intro.gd" id="1_intro"]

[node name="Intro" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_intro")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
alignment = 1

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Boost Gauge — Click at Center!"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 28

[node name="Gauge" type="TextureProgressBar" parent="Margin/VBox"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
min_size = Vector2(0, 40)
value = 0.0
show_percentage = false
mouse_filter = 2

[node name="Hint" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Click to lock in boost"
horizontal_alignment = 1
